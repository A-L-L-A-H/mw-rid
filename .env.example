# Environment variables for MoonWitness services
# Copy to .env and fill in values

# Service identification
MW_SERVICE_NAME=mw-rid
MW_SERVICE_PORT=4480

# Common optional settings
# MW_LOG_LEVEL=info
# MW_LOG_FORMAT=json

# Uncomment and configure as needed.
# Issuer must match MW_RID_ISSUER on every consuming service exactly.
# MW_RID_ISSUER=https://id.${MW_DOMAIN:-mw.local}
# JWKS discovery is normally derived from the issuer; set only for an override.
# MW_RID_JWKS_URL=https://id.${MW_DOMAIN:-mw.local}/jwks
# Default audience stamped into issued tokens; must match MW_RID_AUDIENCE on consumers.
# MW_RID_DEFAULT_AUDIENCE=urn:moonwitness:api
# MW_ECHO_URL=http://127.0.0.1:4310
# MW_ECHO_TOKEN=
# MW_LAB_URL=http://127.0.0.1:8090
# MW_CP_URL=http://127.0.0.1:3003
# MW_DOCK_URL=http://127.0.0.1:3000
# MW_CORPUS_URL=http://127.0.0.1:4420
# MW_NEXUS_URL=http://127.0.0.1:4430
# MW_LORE_URL=http://127.0.0.1:4450
# MW_MYLOVE_URL=http://127.0.0.1:4460
# MW_STUDIO_URL=http://127.0.0.1:4470
# MW_MISSION_URL=http://127.0.0.1:4410
# MW_RID_URL=https://id.${MW_DOMAIN:-mw.local}

# Database (if applicable)
# DATABASE_URL=sqlite:///./data.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/db

# Security (if applicable)
# MW_MASTER_KEY=
# MW_SIGNING_KEY=
# Filesystem path to the RID signing key used for RS256 tokens and JWKS.
# MW_RID_SIGNING_KEY_PATH=
